<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MobileCDInventory.ViewModels"
             x:Class="MobileCDInventory.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#1E1E1E">

    <DockPanel LastChildFill="True">        
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="Plaxton's CD's" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto"> 
                    <TextBox Name="TxtSearch"
                             Text="{Binding SearchQuery}" 
                             Grid.Row="0" Grid.Column="0" 
                             Watermark="Search Artist or Title..." 
                             Margin="0,0,10,10">
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding $parent[TextBox].Clear}"
                                    IsVisible="{Binding #TxtSearch.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Content="✖"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"/>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <Button Name="BtnSync" Click="BtnSync_Click" Grid.Row="0" Grid.Column="1" 
                            Content="⬇️ Sync DB" Background="#0078D7" Foreground="White" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                        <ComboBox Name="CmbGenre" 
                                  ItemsSource="{Binding Genres}" 
                                  SelectedItem="{Binding SelectedGenre}"
                                  HorizontalAlignment="Stretch" 
                                  PlaceholderText="Filter by Genre..."/>
                        <Button Grid.Column="1"
                                Content="{Binding SortButtonText}"
                                Command="{Binding ToggleSort}"
                                Margin="10,0,0,0"
                                Background="#3F3F46"
                                Foreground="White"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#1E1E1E"
                Padding="5"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0">
            <TextBlock Name="LblStatus" Text="{Binding StatusMessage}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
        </Border>

        <Grid>
            <ListBox Name="ListAlbums" 
                     ItemsSource="{Binding Albums}"
                     SelectedItem="{Binding SelectedAlbum}"
                     IsVisible="{Binding !IsShowingTracks}"
                     Background="Transparent" Padding="10">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#3F3F46"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#333337"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="8" Padding="15" Margin="0,5" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Artist}" FontWeight="Bold" FontSize="16" Foreground="Cyan"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="White" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <Grid ColumnDefinitions="*, *, *" Margin="0,10,0,0">
                                    <TextBlock Grid.Column="0" Text="{Binding Format}" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Genre}" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Year}" FontSize="12" Foreground="Gray" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="#1E1E1E" 
                    IsVisible="{Binding IsShowingTracks}"
                    Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,15">
                        <Button Content="← Back to Collection" 
                                Command="{Binding CloseTracks}"
                                Background="#3F3F46" Foreground="White"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding SelectedAlbum.Artist}" FontWeight="Bold" FontSize="18" Foreground="Cyan"/>
                        <TextBlock Text="{Binding SelectedAlbum.Title}" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
                        <Separator Background="#3F3F46" Margin="0,5"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CurrentAlbumTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="35, *, Auto" Margin="0,8">
                                        <TextBlock Grid.Column="0" Text="{Binding TrackNumber}" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>